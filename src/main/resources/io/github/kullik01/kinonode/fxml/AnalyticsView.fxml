<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;"
            stylesheets="@../css/theme.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.kullik01.kinonode.controller.AnalyticsController">
    <content>
        <VBox spacing="20.0" styleClass="detail-pane" style="-fx-padding: 24px;">
            
            <!-- Page Header & Action Buttons -->
            <VBox spacing="16.0" styleClass="analytics-header-card">
                <VBox spacing="4.0">
                    <Label text="Collection Insights &amp; Analytics" styleClass="analytics-title"/>
                    <Label text="Real-time catalog metrics, visual charts, and distribution reports." styleClass="analytics-subtitle"/>
                </VBox>
                
                <FlowPane hgap="12.0" vgap="12.0">
                    <Button text="📥  Export JSON" styleClass="analytics-action-button" onAction="#handleExportJson">
                        <tooltip><Tooltip showDelay="100ms" text="Export entire movie catalog to JSON format"/></tooltip>
                    </Button>
                    <Button text="📊  Export CSV" styleClass="analytics-action-button" onAction="#handleExportCsv">
                        <tooltip><Tooltip showDelay="100ms" text="Export movie catalog spreadsheet to CSV format"/></tooltip>
                    </Button>
                    <Button text="🌐  HTML Visual Report" styleClass="analytics-action-button" onAction="#handleExportHtml">
                        <tooltip><Tooltip showDelay="100ms" text="Generate a styled HTML report of your collection"/></tooltip>
                    </Button>
                </FlowPane>
            </VBox>
            
            <!-- KPI Summary Cards 3-Column GridPane (Exact 33.33% column widths) -->
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3333"/>
                    <ColumnConstraints percentWidth="33.3333"/>
                    <ColumnConstraints percentWidth="33.3334"/>
                </columnConstraints>

                <!-- Row 0 -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity" styleClass="analytics-kpi-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="🍿" styleClass="analytics-kpi-icon"/>
                        <Label text="TOTAL MOVIES" styleClass="analytics-kpi-title"/>
                    </HBox>
                    <Label fx:id="lblTotalMovies" text="0" styleClass="analytics-kpi-value"/>
                    <Label text="titles in catalog" styleClass="analytics-kpi-subtitle"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" styleClass="analytics-kpi-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="⭐" styleClass="analytics-kpi-icon"/>
                        <Label text="AVERAGE RATING" styleClass="analytics-kpi-title"/>
                    </HBox>
                    <Label fx:id="lblAvgRating" text="—" styleClass="analytics-kpi-value"/>
                    <Label text="out of 10.0 scale" styleClass="analytics-kpi-subtitle"/>
                </VBox>

                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity" styleClass="analytics-kpi-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="📅" styleClass="analytics-kpi-icon"/>
                        <Label text="RELEASE ERA" styleClass="analytics-kpi-title"/>
                    </HBox>
                    <Label fx:id="lblYearRange" text="—" styleClass="analytics-kpi-value"/>
                    <Label text="year range span" styleClass="analytics-kpi-subtitle"/>
                </VBox>

                <!-- Row 1 -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity" styleClass="analytics-kpi-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="📑" styleClass="analytics-kpi-icon"/>
                        <Label text="WATCHLISTS" styleClass="analytics-kpi-title"/>
                    </HBox>
                    <Label fx:id="lblTotalWatchlists" text="0" styleClass="analytics-kpi-value"/>
                    <Label text="active collections" styleClass="analytics-kpi-subtitle"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" styleClass="analytics-kpi-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="🏷️" styleClass="analytics-kpi-icon"/>
                        <Label text="TOP GENRE" styleClass="analytics-kpi-title"/>
                    </HBox>
                    <Label fx:id="lblTopGenre" text="—" styleClass="analytics-kpi-value"/>
                    <Label text="most frequent genre" styleClass="analytics-kpi-subtitle"/>
                </VBox>

                <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" maxWidth="Infinity" styleClass="analytics-kpi-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="🎬" styleClass="analytics-kpi-icon"/>
                        <Label text="DIRECTORS" styleClass="analytics-kpi-title"/>
                    </HBox>
                    <Label fx:id="lblTotalDirectors" text="0" styleClass="analytics-kpi-value"/>
                    <Label text="unique filmmakers" styleClass="analytics-kpi-subtitle"/>
                </VBox>
            </GridPane>
            
            <!-- Charts & Top Lists 2-Column GridPane -->
            <GridPane hgap="16.0" vgap="16.0" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>

                <!-- Row 0: Charts (Decades & Ratings) -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity" styleClass="analytics-section-card">
                    <Label text="Movies per Decade" styleClass="analytics-section-header"/>
                    <BarChart fx:id="decadeChart" legendVisible="false" animated="false" prefHeight="260.0">
                        <xAxis>
                            <CategoryAxis label="Decade"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Count"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" styleClass="analytics-section-card">
                    <Label text="Rating Breakdown (0-10)" styleClass="analytics-section-header"/>
                    <BarChart fx:id="ratingChart" legendVisible="false" animated="false" prefHeight="260.0">
                        <xAxis>
                            <CategoryAxis label="Rating"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Count"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <!-- Row 1: Left: Genre Distribution Diagram | Right: Filterable Top People Window -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity" styleClass="analytics-section-card">
                    <Label text="Movie Genres &amp; Appearance" styleClass="analytics-section-header"/>
                    <BarChart fx:id="genreChart" legendVisible="false" animated="false" prefHeight="260.0">
                        <xAxis>
                            <CategoryAxis label="Genre"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Count"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" styleClass="analytics-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Top People" styleClass="analytics-section-header"/>
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="comboRoleFilter" onAction="#handleRoleFilterChange"/>
                    </HBox>
                    <VBox fx:id="topPeopleBox" spacing="10.0" style="-fx-padding: 10px 0 0 0;"/>
                </VBox>
            </GridPane>
            
        </VBox>
    </content>
</ScrollPane>
