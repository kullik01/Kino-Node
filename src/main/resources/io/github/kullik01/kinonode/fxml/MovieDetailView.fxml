<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20.0" styleClass="detail-pane"
      stylesheets="@../css/theme.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.kullik01.kinonode.controller.MovieDetailController">
    
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <!-- Header / Back button -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#goBack" styleClass="button-secondary" text="⬅" minWidth="-Infinity">
            <tooltip><Tooltip showDelay="250ms" text="Back to Library"/></tooltip>
        </Button>
        <Label fx:id="lblHeaderTitle" styleClass="detail-title" text="Movie Details" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="edge-to-edge" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;" VBox.vgrow="ALWAYS">
        <HBox spacing="30.0" style="-fx-padding: 0 10px 0 0;">
            
            <!-- Left Side: Editable details and custom rating -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            
            <GridPane hgap="15.0" vgap="15.0" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="160.0" prefWidth="180.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="30.0" />
                    <RowConstraints minHeight="100.0" />
                </rowConstraints>
                
                <!-- Title -->
                <Label style="-fx-font-weight: bold;" text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER_LEFT">
                    <TextField fx:id="txtTitle" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" HBox.hgrow="ALWAYS" />
                    <Button onAction="#editTitle" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Title"/></tooltip></Button>
                </HBox>

                <!-- Year -->
                <Label style="-fx-font-weight: bold;" text="Release Year:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="CENTER_LEFT">
                    <TextField fx:id="txtYear" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" HBox.hgrow="ALWAYS" />
                    <Button onAction="#editYear" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Year"/></tooltip></Button>
                </HBox>

                <!-- Duration -->
                <Label style="-fx-font-weight: bold;" text="Duration:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2" alignment="CENTER_LEFT">
                    <TextField fx:id="txtDuration" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" HBox.hgrow="ALWAYS" />
                    <Button onAction="#editDuration" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Duration"/></tooltip></Button>
                </HBox>

                <!-- Genre -->
                <Label style="-fx-font-weight: bold;" text="Genre:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3" alignment="CENTER_LEFT">
                    <TextField fx:id="txtGenre" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" HBox.hgrow="ALWAYS" />
                    <Button onAction="#editGenre" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Genre"/></tooltip></Button>
                </HBox>

                <!-- Director -->
                <Label style="-fx-font-weight: bold;" text="Director(s):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="txtDirector" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" visible="true" managed="true" />
                        <ComboBox fx:id="comboDirector" maxWidth="1.7976931348623157E308" visible="false" managed="false" />
                    </StackPane>
                    <Button fx:id="btnImdbDirector" onAction="#searchDirectorOnImdb" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open Director in IMDb"/></tooltip>
                    </Button>
                    <Button onAction="#editDirector" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Director"/></tooltip></Button>
                </HBox>

                <!-- Writer -->
                <Label style="-fx-font-weight: bold;" text="Writer(s):" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="5" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="txtWriter" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" visible="true" managed="true" />
                        <ComboBox fx:id="comboWriter" maxWidth="1.7976931348623157E308" visible="false" managed="false" />
                    </StackPane>
                    <Button fx:id="btnImdbWriter" onAction="#searchWriterOnImdb" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open Writer in IMDb"/></tooltip>
                    </Button>
                    <Button onAction="#editWriter" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Writer"/></tooltip></Button>
                </HBox>

                <!-- Producer -->
                <Label style="-fx-font-weight: bold;" text="Producer(s):" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="6" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="txtProducer" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" visible="true" managed="true" />
                        <ComboBox fx:id="comboProducer" maxWidth="1.7976931348623157E308" visible="false" managed="false" />
                    </StackPane>
                    <Button fx:id="btnImdbProducer" onAction="#searchProducerOnImdb" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open Producer in IMDb"/></tooltip>
                    </Button>
                    <Button onAction="#editProducer" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Producer"/></tooltip></Button>
                </HBox>

                <!-- Cinematographer -->
                <Label style="-fx-font-weight: bold;" text="Cinematographer(s):" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="7" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="txtCinematographer" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" visible="true" managed="true" />
                        <ComboBox fx:id="comboCinematographer" maxWidth="1.7976931348623157E308" visible="false" managed="false" />
                    </StackPane>
                    <Button fx:id="btnImdbCinematographer" onAction="#searchCinematographerOnImdb" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open Cinematographer in IMDb"/></tooltip>
                    </Button>
                    <Button onAction="#editCinematographer" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Cinematographer"/></tooltip></Button>
                </HBox>

                <!-- Composer -->
                <Label style="-fx-font-weight: bold;" text="Composer(s):" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="8" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="txtComposer" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" visible="true" managed="true" />
                        <ComboBox fx:id="comboComposer" maxWidth="1.7976931348623157E308" visible="false" managed="false" />
                    </StackPane>
                    <Button fx:id="btnImdbComposer" onAction="#searchComposerOnImdb" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open Composer in IMDb"/></tooltip>
                    </Button>
                    <Button onAction="#editComposer" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Composer"/></tooltip></Button>
                </HBox>

                <!-- Actors -->
                <Label style="-fx-font-weight: bold;" text="Actor(s):" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="9" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="txtActors" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" visible="true" managed="true" />
                        <ComboBox fx:id="comboActors" maxWidth="1.7976931348623157E308" visible="false" managed="false" />
                    </StackPane>
                    <Button fx:id="btnImdbActors" onAction="#searchActorsOnImdb" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open Actor in IMDb"/></tooltip>
                    </Button>
                    <Button onAction="#editActors" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Actor(s)"/></tooltip></Button>
                </HBox>

                <!-- Trailer URL -->
                <Label style="-fx-font-weight: bold;" text="Trailer Link:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="10">
                    <TextField fx:id="txtTrailerUrl" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" promptText="https://www.youtube.com/watch?v=..." HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnEditTrailer" onAction="#editTrailerUrl" styleClass="button-secondary" text="📝" minWidth="-Infinity">
                        <tooltip><Tooltip showDelay="250ms" text="Edit Trailer Link"/></tooltip>
                    </Button>
                </HBox>
                
                <!-- Rating -->
                <Label style="-fx-font-weight: bold;" text="Rating:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
                <FlowPane fx:id="ratingContainer" alignment="CENTER_LEFT" hgap="2.0" vgap="4.0" GridPane.columnIndex="1" GridPane.rowIndex="11">
                    <!-- Rating buttons and text will be populated dynamically -->
                </FlowPane>
 
                <!-- Watchlist association -->
                <Label style="-fx-font-weight: bold;" text="Watchlists:" GridPane.columnIndex="0" GridPane.rowIndex="12" />
                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="12">
                    <Label fx:id="lblWatchlistsList" style="-fx-text-fill: -color-fg-muted;" text="None" HBox.hgrow="ALWAYS" />
                    <MenuButton fx:id="menuWatchlists" styleClass="button-secondary" text="➕" minWidth="-Infinity">
                        <tooltip><Tooltip showDelay="250ms" text="Add to Watchlist"/></tooltip>
                    </MenuButton>
                </HBox>

                <!-- Description -->
                <Label style="-fx-font-weight: bold;" text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="13" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="13" alignment="CENTER_LEFT">
                    <TextArea fx:id="txtDescription" style="-fx-text-fill: -color-fg-default;" editable="false" mouseTransparent="true" focusTraversable="false" prefHeight="100.0" wrapText="true" HBox.hgrow="ALWAYS" />
                    <Button onAction="#editDescription" styleClass="button-secondary" text="📝" minWidth="-Infinity"><tooltip><Tooltip showDelay="250ms" text="Edit Description"/></tooltip></Button>
                </HBox>
            </GridPane>

                <!-- Feedback status -->
                <Label fx:id="lblStatus" style="-fx-text-fill: -color-success-fg;" text="" />
            </VBox>

            <!-- Upper Right Corner: Bigger Movie Poster and Watch/Play Actions -->
            <VBox alignment="TOP_CENTER" prefWidth="330.0" spacing="15.0">
                <VBox style="-fx-pref-width: 320px; -fx-pref-height: 480px; -fx-background-radius: 12px;" styleClass="movie-poster-container">
                    <ImageView fx:id="imgPoster" fitHeight="480.0" fitWidth="320.0" styleClass="detail-cover" />
                </VBox>
                <Button onAction="#changePoster" styleClass="button-secondary" minWidth="-Infinity">
                    <graphic>
                        <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 16H6c-.55 0-1-.45-1-1V6c0-.55.45-1 1-1h12c.55 0 1 .45 1 1v12c0 .55-.45 1-1 1zm-4.44-6.23L11.2 15.4l-2.45-3.07c-.2-.25-.59-.25-.79 0l-2.71 3.39c-.26.33-.02.81.39.81h12.7c.41 0 .65-.48.39-.81l-3.84-4.8c-.2-.26-.6-.26-.8 0z" fill="white"/>
                    </graphic>
                    <tooltip><Tooltip showDelay="250ms" text="Change Poster"/></tooltip>
                </Button>
                
                <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 15px 0 0 0;">
                    <Button fx:id="btnPlay" onAction="#playMovie" styleClass="button-play" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M8 5v14l11-7z" fill="white"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Play Movie"/></tooltip>
                    </Button>
                    <Button fx:id="btnTrailer" onAction="#watchTrailer" styleClass="button-secondary" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 1.99-.9 1.99-2L23 5c0-1.1-.9-2-2-2zm0 14H3V5h18v12zm-5-6l-7 4V7z" fill="white"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Watch Trailer"/></tooltip>
                    </Button>
                    <Button fx:id="btnImdbPage" onAction="#openImdbPage" styleClass="button-imdb" minWidth="-Infinity">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="white"/>
                        </graphic>
                        <tooltip><Tooltip showDelay="250ms" text="Open in IMDb"/></tooltip>
                    </Button>
                </VBox>
            </VBox>
        </HBox>
    </ScrollPane>
</VBox>
