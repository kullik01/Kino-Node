<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import atlantafx.base.controls.ToggleSwitch?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.github.kullik01.kinonode.controller.MainController"
           fx:id="rootPane"
           stylesheets="@../css/theme.css"
           style="-fx-background-color: transparent;">
    
    <BorderPane fx:id="mainContainer" prefHeight="768.0" prefWidth="1280.0" styleClass="main-window">
    
    <!-- Sidebar on the Left -->
    <left>
        <VBox styleClass="sidebar">
            
            <Button fx:id="btnLibrary" text="🎬  Library" styleClass="sidebar-button" onAction="#showLibrary" minWidth="-Infinity"/>
            <Button fx:id="btnWatchlists" text="📁  Watchlists" styleClass="sidebar-button" onAction="#showWatchlists" minWidth="-Infinity"/>
            <Button fx:id="btnAnalytics" text="📊  Analytics" styleClass="sidebar-button" onAction="#showAnalytics" minWidth="-Infinity"/>
            <Button fx:id="btnImdb" text="IMDb" styleClass="sidebar-button" onAction="#showImdb">
                <graphic>
                    <SVGPath fx:id="svgImdb" styleClass="settings-svg" scaleX="0.75" scaleY="0.75" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                </graphic>
            </Button>
            <Button fx:id="btnSettings" text="Settings" styleClass="sidebar-button" onAction="#showSettings">
                <graphic>
                    <SVGPath fx:id="svgSettings" styleClass="settings-svg" scaleX="0.75" scaleY="0.75" content="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z" />
                </graphic>
            </Button>
            <Button fx:id="btnAbout" text="About" styleClass="sidebar-button" onAction="#showAbout">
                <graphic>
                    <SVGPath styleClass="settings-svg" scaleX="0.75" scaleY="0.75" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
                </graphic>
            </Button>
            
            <javafx.scene.layout.Region VBox.vgrow="ALWAYS" />
            
            <HBox alignment="CENTER" style="-fx-padding: 0 0 10 0;">
                <ToggleSwitch fx:id="btnThemeToggle" text="☀" minWidth="-Infinity">
                    <tooltip><Tooltip showDelay="250ms" text="Light Mode"/></tooltip>
                </ToggleSwitch>
            </HBox>
        </VBox>
    </left>
    
    <!-- Main Content Area in the Center -->
    <center>
        <VBox styleClass="main-content-vbox">
            
            <!-- Actual Content Area for Views swapping -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Views will be dynamically loaded and swapped here -->
            </StackPane>
        </VBox>
    </center>
</BorderPane>
</StackPane>
