<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import atlantafx.base.controls.ToggleSwitch?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.kullik01.kinonode.controller.MainController"
            prefHeight="768.0" prefWidth="1024.0"
            stylesheets="/io/github/kullik01/kinonode/css/theme.css">
    
    <!-- Sidebar on the Left -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="KinoNode" styleClass="sidebar-title"/>
            
            <Button fx:id="btnLibrary" text="🎬  Library" styleClass="sidebar-button" onAction="#showLibrary"/>
            <Button fx:id="btnWatchlists" text="📁  Watchlists" styleClass="sidebar-button" onAction="#showWatchlists"/>
            <Button fx:id="btnSettings" text="Settings" styleClass="sidebar-button" onAction="#showSettings">
                <graphic>
                    <SVGPath fx:id="svgSettings" styleClass="settings-svg" scaleX="0.75" scaleY="0.75" content="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z" />
                </graphic>
            </Button>
            <Button fx:id="btnAbout" text="ℹ  About" styleClass="sidebar-button" onAction="#showAbout"/>
        </VBox>
    </left>
    
    <!-- Main Content Area in the Center -->
    <center>
        <VBox style="-fx-background-color: -color-bg-default;">
            <!-- Header HBox containing the Theme Toggle Switch in the Upper Right -->
            <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 15 25 10 25; -fx-background-color: -color-bg-default;">
                <HBox HBox.hgrow="ALWAYS"/>
                <ToggleSwitch fx:id="btnThemeToggle" text="☀ Light Mode"/>
            </HBox>
            
            <!-- Actual Content Area for Views swapping -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Views will be dynamically loaded and swapped here -->
            </StackPane>
        </VBox>
    </center>
</BorderPane>
