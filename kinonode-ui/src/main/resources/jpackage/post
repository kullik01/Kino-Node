#!/bin/sh
# RPM post-install script for KinoNode

# 1. Install Icon to system theme paths
mkdir -p /usr/share/icons/hicolor/256x256/apps
mkdir -p /usr/share/pixmaps

if [ -f /opt/KinoNode/lib/app/logo.png ]; then
    cp /opt/KinoNode/lib/app/logo.png /usr/share/icons/hicolor/256x256/apps/kinonode.png
    cp /opt/KinoNode/lib/app/logo.png /usr/share/pixmaps/kinonode.png
elif [ -f /opt/KinoNode/logo.png ]; then
    cp /opt/KinoNode/logo.png /usr/share/icons/hicolor/256x256/apps/kinonode.png
    cp /opt/KinoNode/logo.png /usr/share/pixmaps/kinonode.png
fi

# 2. Deploy Application Menu Entry
mkdir -p /usr/share/applications
cat << 'EOF' > /usr/share/applications/kinonode.desktop
[Desktop Entry]
Name=KinoNode
Comment=Personal Movie Library Manager
Exec=/opt/KinoNode/bin/KinoNode
Icon=/usr/share/icons/hicolor/256x256/apps/kinonode.png
Terminal=false
Type=Application
Categories=Utility;Application;
EOF
chmod 644 /usr/share/applications/kinonode.desktop

# 3. Deploy Desktop Icon to all user desktop folders
for USER_HOME in /home/*; do
    if [ -d "$USER_HOME" ]; then
        DESKTOP_DIR="$USER_HOME/Desktop"
        if [ -d "$DESKTOP_DIR" ]; then
            cp /usr/share/applications/kinonode.desktop "$DESKTOP_DIR/KinoNode.desktop"
            chmod 755 "$DESKTOP_DIR/KinoNode.desktop"
            chown "$(basename "$USER_HOME")" "$DESKTOP_DIR/KinoNode.desktop" 2>/dev/null || true
            su - "$(basename "$USER_HOME")" -c "gio set '$DESKTOP_DIR/KinoNode.desktop' 'metadata::trusted' true" 2>/dev/null || true
        fi
    fi
done

# 4. Refresh System Icon & Desktop Caches
update-desktop-database -q /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor 2>/dev/null || true

exit 0
